# MEMORYOS Environment Configuration Template
PROJECT_NAME="MEMORYOS"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=false

# Security
SECRET_KEY="replace-with-a-strong-local-secret-key-32-chars-minimum"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5438
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="memoryos"
SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://postgres:postgrespassword@localhost:5438/memoryos"

# Redis Configuration
REDIS_URL="redis://localhost:6385"
REDIS_TTL_SECONDS=3600

# Embedding & AI Models
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
LLM_PROVIDER="offline_deterministic"
LLM_API_KEY=""

# Retrieval Configuration
RETRIEVAL_RRF_K=60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
MAX_RETRIEVAL_CANDIDATES=20

